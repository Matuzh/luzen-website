---
import ProjectRow from "./ProjectRow.astro";
---

<section id="projects" class="border-b border-line">
  <div class="mx-auto max-w-7xl">
    <div class="grid border-b border-line lg:grid-cols-[1fr_2fr]">
      <div class="px-6 py-12 lg:border-r lg:border-line lg:px-8 lg:py-16">
        <p class="text-xs font-medium tracking-widest text-muted uppercase">
          Projects
        </p>
      </div>

      <div class="px-6 py-12 lg:px-8 lg:py-16">
        <h2 class="max-w-3xl text-3xl font-medium tracking-tight sm:text-4xl">
          Things we've built, tried or left unfinished.
        </h2>
      </div>
    </div>

    <article class="grid lg:grid-cols-[1fr_2fr]">
      <div class="px-6 py-12 lg:border-r lg:border-line lg:px-8 lg:py-20">
        <p class="text-xs font-medium tracking-widest text-brand uppercase">
          Currently building
        </p>
      </div>

      <div class="px-6 py-12 lg:px-8 lg:py-20">
        <h3 class="text-5xl font-semibold tracking-tighter sm:text-6xl">
          2D Survival
        </h3>

        <p class="mt-8 max-w-2xl text-lg leading-8 text-muted">
          A top-down survival RPG focused on exploration, progression and a
          world that can keep growing. Built slowly as both a game and a place
          to learn how larger systems fit together.
        </p>

        <p class="mt-12 text-sm text-muted">
          Phaser · TypeScript · In development
        </p>
      </div>
    </article>

    <div class="border-t border-line px-6 py-6 lg:px-8">
      <p class="text-xs font-medium tracking-widest text-muted uppercase">
        Other projects
      </p>
    </div>

    <ProjectRow
      title="LuzeN Computer Service"
      status="Archived"
      description="A local computer service run under the LuzeN name. Its website at luzen.pl presented the services and provided a way to get in touch. The computer service is no longer active."
      details="Computer service · Website · 2025"
    />

    <ProjectRow
      title="LuzeN Marketplace"
      status="Unfinished"
      description="An unfinished attempt to create amarketplace under the LuzeN name. Development stopped at an early stage."
      details="Marketplace · Early development"
    />
  </div>
</section>