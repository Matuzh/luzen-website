---
interface Props {
  title: string;
  status: string;
  description: string;
  details: string;
}

const { title, status, description, details } = Astro.props;
---

<article class="grid border-t border-line lg:grid-cols-[1fr_2fr]">
  <div class="px-6 py-10 lg:border-r lg:border-line lg:px-8">
    <p class="text-xs font-medium tracking-widest text-muted uppercase">
      {status}
    </p>
  </div>

  <div class="px-6 py-10 lg:px-8">
    <h3 class="text-2xl font-medium tracking-tight">
      {title}
    </h3>

    <p class="mt-4 max-w-2xl leading-7 text-muted">
      {description}
    </p>

    <p class="mt-8 text-sm text-muted">
      {details}
    </p>
  </div>
</article>